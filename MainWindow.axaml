<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileSearchTool.ViewModels"
        x:Class="FileSearchTool.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Title="SearchEngineTool" Width="1400" Height="700"
        Background="{DynamicResource AppBackgroundBrush}">

  <DockPanel Margin="16">

    <!-- MAIN CONTENT -->
    <SplitView IsPaneOpen="{Binding IsResultsPaneOpen}"
               OpenPaneLength="380"
               CompactPaneLength="0"
               DisplayMode="Inline"
               Background="{DynamicResource AppBackgroundBrush}"
               PaneBackground="{DynamicResource AppBackgroundBrush}">

      <!-- RESULTS PANE -->
      <SplitView.Pane>
  <StackPanel Spacing="12">

    <!-- COMPACT COMMAND SURFACE (kun venstre side nu) -->
    <Border Classes="GlassCard GlassCardStrong PaneHeader" Padding="12">
      <StackPanel Spacing="10">

        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="10"
              RowSpacing="10">

          <Button Grid.Row="0" Grid.Column="0"
                  Classes="GlassButton"
                  Content="☰"
                  Command="{Binding ToggleResultsPaneCommand}"/>

          <Button Grid.Row="0" Grid.Column="1"
                  Classes="GlassButton"
                  Content="Seneste mapper"
                  Command="{Binding ToggleRecentFoldersCommand}"/>

          <TextBlock Grid.Row="0" Grid.Column="2"
                     Text="Mappe"
                     VerticalAlignment="Center"
                     Opacity="0.85"/>

          <TextBox Grid.Row="0" Grid.Column="3"
                   Classes="GlassTextBox GlassTextBoxDark"
                   Text="{Binding SelectedFolder}"/>

          <Button Grid.Row="0" Grid.Column="4"
                  Classes="GlassButton"
                  Content="Vælg…"
                  Click="PickFolder_Click"/>

          <TextBlock Grid.Row="1" Grid.Column="2"
                     Text="Query"
                     VerticalAlignment="Center"
                     Opacity="0.85"/>

          <TextBox Grid.Row="1" Grid.Column="3"
                   Classes="GlassTextBox GlassTextBoxDark"
                   Text="{Binding Query}"
                   KeyDown="QueryBox_KeyDown"/>

          <Button Grid.Row="1" Grid.Column="4"
                  Classes="GlassPrimary"
                  Content="Search"
                  Command="{Binding SearchCommand}"
                  IsDefault="True"/>
        </Grid>

        <TextBlock Text="{Binding Status}"
                   Opacity="0.80"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- RECENT FOLDERS DROPDOWN PANEL -->
    <Border IsVisible="{Binding IsRecentFoldersOpen}"
            Classes="GlassCard"
            Padding="12">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Seneste mapper" FontWeight="SemiBold" FontSize="16"/>
          <Button Grid.Column="1"
                  Classes="GlassButton"
                  Content="Skjul"
                  Command="{Binding ToggleRecentFoldersCommand}"/>
        </Grid>

        <ListBox Classes="GlassList"
                 ItemsSource="{Binding RecentFolders}"
                 SelectedItem="{Binding SelectedRecentFolder}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Classes="GlassItemCard" Padding="10">
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>

          <ListBox.ItemContainerTheme>
            <ControlTheme TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0,0,0,8"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="0"/>
            </ControlTheme>
          </ListBox.ItemContainerTheme>
        </ListBox>
      </StackPanel>
    </Border>

    <!-- RESULTS + HITS -->
    <Border Classes="GlassCard PaneBody" Padding="12">
      <Grid RowDefinitions="Auto,*,Auto,*" RowSpacing="10">

        <TextBlock Grid.Row="0" Text="Resultater" FontWeight="SemiBold" FontSize="16"/>

        <ListBox Grid.Row="1"
                 Classes="GlassList"
                 ItemsSource="{Binding Results}"
                 SelectedItem="{Binding SelectedResult}"
                 DoubleTapped="Results_DoubleTapped">

          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Classes="GlassItemCard" Padding="10">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding HitSummary}"
                             Opacity="0.85"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>

          <ListBox.ItemContainerTheme>
            <ControlTheme TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0,0,0,8"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="0"/>
            </ControlTheme>
          </ListBox.ItemContainerTheme>
        </ListBox>

        <TextBlock Grid.Row="2"
                   Text="Hits"
                   FontWeight="SemiBold"
                   FontSize="16"
                   Margin="0,8,0,0"/>

        <ListBox Grid.Row="3"
                 Classes="GlassList"
                 ItemsSource="{Binding CurrentPreview.SidebarItems}"
                 SelectedItem="{Binding CurrentPreview.SelectedSidebarItem}">

          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Classes="GlassItemCard" Padding="10">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Context}"
                             Opacity="0.85"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>

          <ListBox.ItemContainerTheme>
            <ControlTheme TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0,0,0,8"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="0"/>
            </ControlTheme>
          </ListBox.ItemContainerTheme>
        </ListBox>

      </Grid>
    </Border>

  </StackPanel>
</SplitView.Pane>

      <!-- RIGHT SIDE -->
      <SplitView.Content>
        <Grid>

          <!-- Placeholder (no preview) -->
          <Border IsVisible="{Binding HasNoPreview}"
                  Classes="GlassCard"
                  Padding="18">
            <StackPanel Spacing="8">
              <TextBlock Text="PDF preview" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="Søg, og vælg et PDF-resultat for preview."
                         Opacity="0.80"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Preview (has preview) -->
          <Grid IsVisible="{Binding HasPreview}"
                RowDefinitions="Auto,*"
                RowSpacing="12">

            <!-- Preview toolbar -->
            <Border Grid.Row="0" Classes="GlassCard" Padding="10">
              <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto"
                    ColumnSpacing="10">

                <Button Grid.Column="0"
                        Classes="GlassButton"
                        Content="◀ Hit"
                        Command="{Binding CurrentPreview.PrevHitCommand}"/>

                <Button Grid.Column="1"
                        Classes="GlassButton"
                        Content="Hit ▶"
                        Command="{Binding CurrentPreview.NextHitCommand}"/>

                <Button Grid.Column="2"
                        Classes="GlassButton"
                        Content="◀ Side"
                        Command="{Binding CurrentPreview.PrevPageCommand}"/>

                <Button Grid.Column="3"
                        Classes="GlassButton"
                        Content="Side ▶"
                        Command="{Binding CurrentPreview.NextPageCommand}"/>

                <Button Grid.Column="4"
                        Classes="GlassButton"
                        Content="−"
                        Command="{Binding CurrentPreview.ZoomOutCommand}"/>

                <Button Grid.Column="5"
                        Classes="GlassButton"
                        Content="+"
                        Command="{Binding CurrentPreview.ZoomInCommand}"/>

                <TextBlock Grid.Column="7"
                           VerticalAlignment="Center"
                           Opacity="0.82"
                           Text="{Binding CurrentPreview.HitStatus}"/>

                <TextBlock Grid.Column="8"
                           VerticalAlignment="Center"
                           Opacity="0.82"
                           Text="{Binding CurrentPreview.PageStatus}"/>
              </Grid>
            </Border>

            <!-- Preview content -->
            <Border Grid.Row="1" Classes="GlassCard" Padding="12">
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                <Grid>
                  <Image Source="{Binding CurrentPreview.PageBitmap}"
                         Stretch="None"
                         Width="{Binding CurrentPreview.PagePixelWidth}"
                         Height="{Binding CurrentPreview.PagePixelHeight}" />
                  <Canvas x:Name="MainOverlayCanvas"
                          Canvas.ZIndex="10"
                          IsHitTestVisible="False"
                          Width="{Binding CurrentPreview.PagePixelWidth}"
                          Height="{Binding CurrentPreview.PagePixelHeight}" />
                </Grid>
              </ScrollViewer>
            </Border>
          </Grid>

        </Grid>
      </SplitView.Content>
    </SplitView>

  </DockPanel>
</Window>