<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileSearchTool.ViewModels"
        x:Class="FileSearchTool.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Title="SearchEngineTool" Width="1400" Height="600">

    <DockPanel Margin="12">

    <!-- Top panel (behold jeres mappe+query controls) -->
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="☰"
                Command="{Binding ToggleResultsPaneCommand}"/>
        
        <Button Content="Seneste mapper"
                Command="{Binding ToggleRecentFoldersCommand}"/>

        <TextBlock Text="Mappe:" VerticalAlignment="Center"/>
        <TextBox Width="520" Text="{Binding SelectedFolder}"/>
        <Button Content="Vælg..." Click="PickFolder_Click"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Query:" VerticalAlignment="Center"/>
        <TextBox Width="600"
                 Text="{Binding Query}"
                 KeyDown="QueryBox_KeyDown"/>
        <Button Content="Search"
                Command="{Binding SearchCommand}"
                IsDefault="True"/>
      </StackPanel>

      <TextBlock Text="{Binding Status}" />
    </StackPanel>
    
    <Border IsVisible="{Binding IsRecentFoldersOpen}"
            Margin="0,8,0,8"
            Padding="12"
            BorderThickness="1"
            BorderBrush="{DynamicResource ThemeBorderMidBrush}">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Seneste mapper" FontWeight="Bold"/>
          <Button Content="Skjul"
                  Command="{Binding ToggleRecentFoldersCommand}"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding RecentFolders}"
                 SelectedItem="{Binding SelectedRecentFolder}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>
    
    <!-- Results as burger pane -->
    <SplitView IsPaneOpen="{Binding IsResultsPaneOpen}"
               OpenPaneLength="420"
               CompactPaneLength="0"
               DisplayMode="Inline">

      <SplitView.Pane>
        <Border Padding="8" BorderThickness="1"
                BorderBrush="{DynamicResource ThemeBorderMidBrush}">
          <StackPanel Spacing="8">
            <TextBlock Text="Resultater" FontWeight="Bold"/>
            <ListBox ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult}"
                     DoubleTapped="Results_DoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Snippet}" Opacity="0.8" TextWrapping="Wrap"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
      </SplitView.Pane>

      <SplitView.Content>
  <Grid Margin="12,0,0,0">

    <!-- Placeholder når der ikke er preview -->
    <Border IsVisible="{Binding HasNoPreview}"
            Padding="16"
            BorderThickness="1"
            BorderBrush="{DynamicResource ThemeBorderMidBrush}">
      <TextBlock Text="Søg, og vælg et PDF-resultat for preview."
                 Opacity="0.7"/>
    </Border>

    <!-- Preview når der ER preview -->
    <Grid IsVisible="{Binding HasPreview}"
          RowDefinitions="Auto,*">

      <!-- Preview toolbar -->
      <Border Padding="8"
              BorderThickness="1"
              BorderBrush="{DynamicResource ThemeBorderMidBrush}">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto">
          <Button Content="◀ Hit" Grid.Column="0"
                  Command="{Binding CurrentPreview.PrevHitCommand}"/>
          <Button Content="Hit ▶" Grid.Column="1"
                  Command="{Binding CurrentPreview.NextHitCommand}"/>

          <Button Content="◀ Side" Grid.Column="2"
                  Command="{Binding CurrentPreview.PrevPageCommand}"/>
          <Button Content="Side ▶" Grid.Column="3"
                  Command="{Binding CurrentPreview.NextPageCommand}"/>

          <Button Content="-" Grid.Column="4"
                  Command="{Binding CurrentPreview.ZoomOutCommand}"/>
          <Button Content="+" Grid.Column="5"
                  Command="{Binding CurrentPreview.ZoomInCommand}"/>

          <TextBlock Grid.Column="7"
                     VerticalAlignment="Center"
                     Text="{Binding CurrentPreview.HitStatus}"/>
          <TextBlock Grid.Column="8"
                     VerticalAlignment="Center"
                     Margin="12,0,0,0"
                     Text="{Binding CurrentPreview.PageStatus}"/>
        </Grid>
      </Border>

      <!-- Preview content -->
      <Grid Grid.Row="1" ColumnDefinitions="260,*" Margin="0,12,0,0">

        <Border Grid.Column="0" Padding="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource ThemeBorderMidBrush}">
          <StackPanel Spacing="8">
            <TextBlock Text="Hits" FontWeight="Bold"/>
            <ListBox ItemsSource="{Binding CurrentPreview.SidebarItems}"
                     SelectedItem="{Binding CurrentPreview.SelectedSidebarItem}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Padding="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource ThemeBorderMidBrush}">
          <Viewbox Stretch="Uniform">
            <Grid>
              <Image Source="{Binding CurrentPreview.PageBitmap}"
                     Stretch="None"
                     Width="{Binding CurrentPreview.PagePixelWidth}"
                     Height="{Binding CurrentPreview.PagePixelHeight}" />
              <Canvas x:Name="MainOverlayCanvas"
                      Canvas.ZIndex="10"
                      IsHitTestVisible="False"
                      Width="{Binding CurrentPreview.PagePixelWidth}"
                      Height="{Binding CurrentPreview.PagePixelHeight}" />
            </Grid>
          </Viewbox>
        </Border>

      </Grid>
    </Grid>

  </Grid>
</SplitView.Content>

    </SplitView>

  </DockPanel>
</Window>
