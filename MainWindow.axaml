<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileSearchTool.ViewModels"
        x:Class="FileSearchTool.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Title="SearchEngineTool" Width="900" Height="600">

    <DockPanel Margin="12" LastChildFill="True">

        <!-- Left: Recent folders -->
        <Border DockPanel.Dock="Left" Width="280" Margin="0,0,12,0">
            <StackPanel Spacing="8">
                <TextBlock Text="Seneste mapper" FontWeight="Bold"/>

                <ListBox ItemsSource="{Binding RecentFolders}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding .}"
                                    HorizontalAlignment="Stretch"
                                    Click="RecentFolder_Click"
                                    Tag="{Binding .}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Top panel -->
        <StackPanel DockPanel.Dock="Top" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Mappe:" VerticalAlignment="Center"/>
                <TextBox Width="600" Text="{Binding SelectedFolder}"/>
                <Button Content="Vælg..." Click="PickFolder_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Query:" VerticalAlignment="Center"/>
                <TextBox Width="600"
                         Text="{Binding Query}"
                         KeyDown="QueryBox_KeyDown"/>
                <Button Content="Search"
                        Command="{Binding SearchCommand}"
                        IsDefault="True"/>
            </StackPanel>

            <TextBlock Text="{Binding Status}" />
        </StackPanel>

        <!-- Results -->
        <ListBox ItemsSource="{Binding Results}"
                 SelectedItem="{Binding SelectedResult}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding FilePath}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Snippet}" Opacity="0.8" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
