<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileSearchTool.ViewModels"
        x:Class="FileSearchTool.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Title="FileSearchTool" Width="1400" Height="760"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Blur">

  <Border Background="{DynamicResource AppWindowTintBrush}">
    <DockPanel Margin="16">

      <!-- MAIN CONTENT -->
      <Grid x:Name="MainLayoutGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{Binding SidebarGridLength}" MinWidth="0"/>
          <ColumnDefinition Width="{Binding SplitterGridLength}" MinWidth="0"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- RESULTS PANE -->
        <Grid Grid.Column="0"
              IsVisible="{Binding IsResultsPaneOpen}">
          <Grid RowDefinitions="Auto,Auto,*"
                RowSpacing="6">

      <!-- COMPACT COMMAND SURFACE (kun venstre side nu) -->
      <Border Grid.Row="0" Classes="GlassCard GlassCardStrong PaneHeader" Padding="12">
        <StackPanel Spacing="14">

          <Button Classes="GlassButton"
                  Content="Seneste mapper"
                  HorizontalAlignment="Left"
                  Command="{Binding ToggleRecentFoldersCommand}"/>

          <!-- ROW 3: Path -->
          <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="12">
            <TextBlock Text="Mappe"
                       VerticalAlignment="Center"
                       Opacity="0.85"/>

            <TextBox Grid.Column="1"
                     Classes="GlassTextBox GlassTextBoxDark"
                     Watermark="Choose a folder with allowed exam materials"
                     Text="{Binding SelectedFolder}"/>

            <Button Grid.Column="2"
                    Classes="GlassButton"
                    Content="Vælg…"
                    MinWidth="90"
                    Click="PickFolder_Click"/>
          </Grid>

          <!-- ROW 4: Query -->
          <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="12">
            <TextBlock Text="Query"
                       VerticalAlignment="Center"
                       Opacity="0.85"/>

            <TextBox Grid.Column="1"
                     Classes="GlassTextBox GlassTextBoxDark"
                     Watermark="Search a term, phrase, or sentence"
                     Text="{Binding Query}"
                     KeyDown="QueryBox_KeyDown"/>

            <Button Grid.Column="2"
                    Classes="GlassPrimary"
                    Content="Search"
                    MinWidth="90"
                    Command="{Binding SearchCommand}"
                    IsDefault="True"/>
          </Grid>

          <TextBlock Text="{Binding Status}"
                     Opacity="0.80"
                     TextWrapping="Wrap"/>
          <TextBlock Text="{Binding SupportedFileTypesText}"
                     Opacity="0.65"
                     FontSize="12"/>
        </StackPanel>
      </Border>

      <!-- RECENT FOLDERS DROPDOWN PANEL -->
      <Border Grid.Row="1"
              IsVisible="{Binding IsRecentFoldersOpen}"
              Classes="GlassCard"
              Padding="12">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Seneste mapper" FontWeight="SemiBold" FontSize="16"/>
            <Button Grid.Column="1"
                    Classes="GlassButton"
                    Content="Skjul"
                    Command="{Binding ToggleRecentFoldersCommand}"/>
          </Grid>

          <ListBox Classes="GlassList"
                   ItemsSource="{Binding RecentFolders}"
                   SelectedItem="{Binding SelectedRecentFolder}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Classes="GlassItemCard" Padding="10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DisplayPath}" Opacity="0.68" FontSize="12" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemContainerTheme>
              <ControlTheme TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
              </ControlTheme>
            </ListBox.ItemContainerTheme>
          </ListBox>
        </StackPanel>
      </Border>

      <!-- RESULTS + HITS -->
      <Border Grid.Row="2" Classes="GlassCard PaneBody" Padding="12">
    <Grid RowDefinitions="*,*" RowSpacing="12">

      <!-- RESULTS -->
      <Grid Grid.Row="0" RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Resultater" FontWeight="SemiBold" FontSize="16"/>
          <TextBlock Grid.Column="1"
                     Text="{Binding ResultCountText}"
                     Opacity="0.70"
                     VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="8">
          <Button Classes="GlassButton"
                  Content="{Binding FileFilterButtonText}"
                  HorizontalAlignment="Left"
                  Command="{Binding ToggleFileFilterCommand}"/>

          <Border Grid.Row="1"
                  IsVisible="{Binding IsFileFilterOpen}"
                  Classes="GlassCard"
                  Padding="10">
            <Grid RowDefinitions="Auto,*" RowSpacing="8"
                  MaxHeight="220">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="Filter files"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Classes="GlassButton"
                        Content="All"
                        Command="{Binding SelectAllFilesCommand}"/>
                <Button Grid.Column="2"
                        Classes="GlassButton"
                        Content="None"
                        Command="{Binding ClearFileFiltersCommand}"/>
              </Grid>

              <ScrollViewer Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FileFilters}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsIncluded}"
                                Margin="0,0,0,8">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding FolderName}"
                                     Opacity="0.65"
                                     FontSize="12"
                                     TextWrapping="Wrap"/>
                        </StackPanel>
                      </CheckBox>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ListBox Classes="GlassList"
                   ItemsSource="{Binding Results}"
                   SelectedItem="{Binding SelectedResult}"
                   DoubleTapped="Results_DoubleTapped">

            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Classes="GlassItemCard" Padding="10">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding PageLabel}"
                                 IsVisible="{Binding HasPageNumber}"
                                 Opacity="0.80"
                                 FontWeight="SemiBold"/>
                    </Grid>
                    <TextBlock Text="{Binding FolderName}" Opacity="0.68" FontSize="12" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding SnippetParts}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Text}"
                                     FontWeight="{Binding FontWeight}"
                                     Background="{Binding Background}"
                                     TextWrapping="Wrap"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemContainerTheme>
              <ControlTheme TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
              </ControlTheme>
            </ListBox.ItemContainerTheme>
          </ListBox>
        </ScrollViewer>
      </Grid>

      <!-- HITS -->
      <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="10">
        <TextBlock Text="Hits" FontWeight="SemiBold" FontSize="16"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ListBox Classes="GlassList"
                   ItemsSource="{Binding CurrentPreview.SidebarItems}"
                   SelectedItem="{Binding CurrentPreview.SelectedSidebarItem}">

            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Classes="GlassItemCard" Padding="10">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Context}" Opacity="0.85" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemContainerTheme>
              <ControlTheme TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
              </ControlTheme>
            </ListBox.ItemContainerTheme>
          </ListBox>
        </ScrollViewer>
      </Grid>

    </Grid>
  </Border>

          </Grid>
        </Grid>

        <!-- DRAG HANDLE -->
        <Border x:Name="SidebarSplitter"
                Grid.Column="1"
                IsVisible="{Binding IsResultsPaneOpen}"
                Background="#00000000"
                Cursor="SizeWestEast"
                PointerPressed="SidebarSplitter_PointerPressed"
                PointerMoved="SidebarSplitter_PointerMoved"
                PointerReleased="SidebarSplitter_PointerReleased">
          <Border Width="6"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Stretch"
                  Background="#18FFFFFF"
                  CornerRadius="3">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="4">
              <Border Width="3" Height="24" Background="#70FFFFFF" CornerRadius="2"/>
              <Border Width="3" Height="24" Background="#70FFFFFF" CornerRadius="2"/>
              <Border Width="3" Height="24" Background="#70FFFFFF" CornerRadius="2"/>
            </StackPanel>
          </Border>
        </Border>

        <!-- RIGHT SIDE -->
        <Grid Grid.Column="2" Margin="12,0,0,0">

            <!-- Placeholder (no preview) -->
            <Border IsVisible="{Binding HasNoPreview}"
                    Classes="GlassCard"
                    Padding="18">
              <StackPanel Spacing="8">
                <TextBlock Text="PDF preview" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Søg, og vælg et PDF-resultat for preview."
                           Opacity="0.80"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <!-- Preview (has preview) -->
            <Grid IsVisible="{Binding HasPreview}"
                  RowDefinitions="Auto,*"
                  RowSpacing="12">

              <!-- Preview toolbar -->
              <Border Grid.Row="0" Classes="GlassCard" Padding="10">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto"
                      ColumnSpacing="10">
                  
                  <Button Grid.Column="0"
                          Classes="GlassButton"
                          Content="☰"
                          Width="44"
                          Command="{Binding ToggleResultsPaneCommand}"/>

                  <Button Grid.Column="1"
                          Classes="GlassButton"
                          Content="◀ Hit"
                          Command="{Binding CurrentPreview.PrevHitCommand}"/>

                  <Button Grid.Column="2"
                          Classes="GlassButton"
                          Content="Hit ▶"
                          Command="{Binding CurrentPreview.NextHitCommand}"/>

                  <Button Grid.Column="3"
                          Classes="GlassButton"
                          Content="◀ Side"
                          Command="{Binding CurrentPreview.PrevPageCommand}"/>

                  <Button Grid.Column="4"
                          Classes="GlassButton"
                          Content="Side ▶"
                          Command="{Binding CurrentPreview.NextPageCommand}"/>

                  <Button Grid.Column="5"
                          Classes="GlassButton"
                          Content="−"
                          Command="{Binding CurrentPreview.ZoomOutCommand}"/>

                  <Button Grid.Column="6"
                          Classes="GlassButton"
                          Content="+"
                          Command="{Binding CurrentPreview.ZoomInCommand}"/>

                  <Button Grid.Column="7"
                          Classes="GlassButton"
                          Content="100%"
                          Command="{Binding CurrentPreview.ZoomResetCommand}"/>

                  <TextBlock Grid.Column="8"
                             VerticalAlignment="Center"
                             Opacity="0.82"
                             Text="{Binding CurrentPreview.HitStatus}"/>

                  <TextBlock Grid.Column="9"
                             VerticalAlignment="Center"
                             Opacity="0.82"
                             Text="{Binding CurrentPreview.PageStatus}"/>
                </Grid>
              </Border>

              <!-- Preview content -->
              <Border Grid.Row="1" Classes="GlassCard" Padding="12">
                <Viewbox Stretch="Uniform"
                         StretchDirection="Both"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                  <Grid Width="{Binding CurrentPreview.PagePixelWidth}"
                        Height="{Binding CurrentPreview.PagePixelHeight}">
                    <Image Source="{Binding CurrentPreview.PageBitmap}"
                           Stretch="Fill"
                           Width="{Binding CurrentPreview.PagePixelWidth}"
                           Height="{Binding CurrentPreview.PagePixelHeight}"/>
                    <Canvas x:Name="MainOverlayCanvas"
                            Canvas.ZIndex="10"
                            IsHitTestVisible="False"
                            Width="{Binding CurrentPreview.PagePixelWidth}"
                            Height="{Binding CurrentPreview.PagePixelHeight}" />
                  </Grid>
                </Viewbox>
              </Border>
            </Grid>

        </Grid>
      </Grid>

    </DockPanel>
  </Border>
</Window>
