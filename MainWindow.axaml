<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileSearchTool.ViewModels"
        x:Class="FileSearchTool.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SearchEngineTool" Width="900" Height="600">

    <DockPanel Margin="12" LastChildFill="True">
    
        <!-- Top panel -->
        <StackPanel DockPanel.Dock="Top" Spacing="8">
      
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Mappe:" VerticalAlignment="Center"/>
                <TextBox Width="600" Text="{Binding SelectedFolder}"/>
                <Button Content="Vælg..." Click="PickFolder_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Query:" VerticalAlignment="Center"/>
                <TextBox Width="600" Text="{Binding Query}"/>
                <Button Content="Search" Command="{Binding SearchCommand}"/>
            </StackPanel>

            <TextBlock Text="{Binding Status}" />
        </StackPanel>

        <!-- Results -->
        <ListBox ItemsSource="{Binding Results}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding FilePath}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Snippet}" Opacity="0.8" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>