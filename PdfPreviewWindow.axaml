<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileSearchTool.ViewModels"
        x:Class="FileSearchTool.PdfPreviewWindow"
        x:DataType="vm:PdfPreviewViewModel"
        Width="1000" Height="800"
        Title="PDF Preview">

    <DockPanel Margin="12">

        <!-- Top toolbar (som før) -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
            <!-- ... behold jeres knapper uændret ... -->
        </StackPanel>

        <!-- Content: sidebar + preview -->
        <Grid ColumnDefinitions="260,*" RowDefinitions="*">
    
            <!-- Sidebar -->
            <Border Grid.Column="0" Margin="0,0,12,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Hits" FontWeight="Bold"/>
                    <ListBox ItemsSource="{Binding SidebarItems}"
                             SelectedItem="{Binding SelectedSidebarItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- PDF view -->
            <ScrollViewer Grid.Column="1">
                <Grid>
                    <Image Source="{Binding PageBitmap}"
                           Stretch="None"
                           Width="{Binding PagePixelWidth}"
                           Height="{Binding PagePixelHeight}" />

                    <Canvas x:Name="OverlayCanvas"
                            Canvas.ZIndex="10"
                            IsHitTestVisible="False"
                            Width="{Binding PagePixelWidth}"
                            Height="{Binding PagePixelHeight}" />
                </Grid>
            </ScrollViewer>

        </Grid>
    </DockPanel>

</Window>