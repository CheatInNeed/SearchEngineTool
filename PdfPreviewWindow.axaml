<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileSearchTool.ViewModels"
        x:Class="FileSearchTool.PdfPreviewWindow"
        x:DataType="vm:PdfPreviewViewModel"
        Width="1000" Height="800"
        Title="PDF Preview">

    <DockPanel Margin="12">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
            <Button Content="◀" Command="{Binding PrevHitCommand}" />
            <Button Content="▶" Command="{Binding NextHitCommand}" />
            <TextBlock Text="{Binding HitStatus}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" Opacity="0.7" Margin="12,0,0,0"/>
            <Button Content="⏮" Command="{Binding PrevPageCommand}" />
            <Button Content="⏭" Command="{Binding NextPageCommand}" />
            <TextBlock Text="{Binding PageStatus}" VerticalAlignment="Center" Opacity="0.7"/>
            <Button Content="-" Command="{Binding ZoomOutCommand}" />
            <Button Content="+" Command="{Binding ZoomInCommand}" />
            <Button Content="Reset" Command="{Binding ZoomResetCommand}" />

            <Slider Width="200"
                    Minimum="0.3"
                    Maximum="3.0"
                    Value="{Binding Zoom, Mode=TwoWay}" />
            <TextBlock Text="{Binding Zoom}" VerticalAlignment="Center" Opacity="0.7"/>
        </StackPanel>

        <ScrollViewer>
            <Grid>
                <!-- PDF-billedet (kun én gang) -->
                <Image Source="{Binding PageBitmap}"
                       Stretch="None"
                       Width="{Binding PagePixelWidth}"
                       Height="{Binding PagePixelHeight}" />

                <!-- Overlay ovenpå -->
                <Canvas x:Name="OverlayCanvas"
                        Canvas.ZIndex="10"
                        IsHitTestVisible="False"
                        Width="{Binding PagePixelWidth}"
                        Height="{Binding PagePixelHeight}" />
            </Grid>
        </ScrollViewer>

    </DockPanel>
</Window>